<Window x:Class="Flipr.UI.Editor.PhotoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:Flipr.UI.Editor"
        Title="Edit" Width="1120" Height="780" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Icon="pack://application:,,,/Flipr.UI;component/Assets/flipr.ico"
        Background="{DynamicResource Orbit.SurfaceBase}"
        FontFamily="{StaticResource Orbit.Font.Text}">
    <Window.Resources>
        <Style x:Key="ToolLabel" TargetType="TextBlock" BasedOn="{StaticResource Orbit.Text.Caption}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="Color" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource Orbit.TextPrimary}" StrokeThickness="2" Opacity="0" />
                            <Ellipse Margin="4" Fill="{TemplateBinding Background}" Stroke="{DynamicResource Orbit.StrokeStrong}" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderRow" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,28,0" />
            <Setter Property="Width" Value="190" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top bar: modes · undo · cancel · save -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Orbit.Surface}" BorderBrush="{DynamicResource Orbit.Stroke}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UndoButton" Style="{StaticResource Orbit.Button.Subtle}" Click="OnUndo" ToolTip="Undo (Ctrl+Z)" Margin="0,0,8,0" Padding="10,6">
                        <TextBlock Style="{StaticResource Orbit.Glyph}" Text="&#xE7A7;" />
                    </Button>
                    <Button Content="Cancel" Style="{StaticResource Orbit.Button.Standard}" MinWidth="92" Margin="0,0,8,0" Click="OnCancel" />
                    <Button x:Name="SaveButton" Content="Save copy" Style="{StaticResource Orbit.Button.Accent}" MinWidth="108" Click="OnSave" ToolTip="Save a copy next to the original (Ctrl+S)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText" Style="{StaticResource Orbit.Text.BodyStrong}" VerticalAlignment="Center" Margin="0,0,20,0"
                               MaxWidth="260" TextTrimming="CharacterEllipsis" />
                    <Border Style="{StaticResource Orbit.SegmentHost}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeCrop" Style="{StaticResource Orbit.Segment}" GroupName="Mode" Checked="OnMode" Content="Crop" />
                            <RadioButton x:Name="ModeAdjust" Style="{StaticResource Orbit.Segment}" GroupName="Mode" Checked="OnMode" Content="Adjust" />
                            <RadioButton x:Name="ModeMarkup" Style="{StaticResource Orbit.Segment}" GroupName="Mode" Checked="OnMode" Content="Markup" />
                            <RadioButton x:Name="ModeRedact" Style="{StaticResource Orbit.Segment}" GroupName="Mode" Checked="OnMode" Content="Redact" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Bottom bar: options for the current mode -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Orbit.Surface}" BorderBrush="{DynamicResource Orbit.Stroke}" BorderThickness="0,1,0,0" Padding="20,12" MinHeight="64">
            <Grid>
                <StackPanel x:Name="CropPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Aspect" Style="{StaticResource ToolLabel}" />
                    <Border Style="{StaticResource Orbit.SegmentHost}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Orbit.Segment}" GroupName="Aspect" Content="Free" Tag="0" IsChecked="True" Checked="OnAspect" />
                            <RadioButton Style="{StaticResource Orbit.Segment}" GroupName="Aspect" Content="Original" Tag="-1" Checked="OnAspect" />
                            <RadioButton Style="{StaticResource Orbit.Segment}" GroupName="Aspect" Content="Square" Tag="1" Checked="OnAspect" />
                            <RadioButton Style="{StaticResource Orbit.Segment}" GroupName="Aspect" Content="4:3" Tag="1.3333333" Checked="OnAspect" />
                            <RadioButton Style="{StaticResource Orbit.Segment}" GroupName="Aspect" Content="3:2" Tag="1.5" Checked="OnAspect" />
                            <RadioButton Style="{StaticResource Orbit.Segment}" GroupName="Aspect" Content="16:9" Tag="1.7777778" Checked="OnAspect" />
                            <RadioButton Style="{StaticResource Orbit.Segment}" GroupName="Aspect" Content="9:16" Tag="0.5625" Checked="OnAspect" />
                        </StackPanel>
                    </Border>
                    <Button Content="Reset crop" Style="{StaticResource Orbit.Button.Standard}" Margin="16,0,0,0" Click="OnResetCrop" />
                    <TextBlock x:Name="CropSizeText" Style="{StaticResource ToolLabel}" Margin="16,0,0,0" />
                </StackPanel>

                <StackPanel x:Name="AdjustPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource SliderRow}">
                        <TextBlock Text="Brightness" Style="{StaticResource Orbit.Text.Caption}" />
                        <Slider x:Name="BrightnessSlider" Minimum="-1" Maximum="1" ValueChanged="OnAdjust" MouseDoubleClick="OnResetSlider" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource SliderRow}">
                        <TextBlock Text="Contrast" Style="{StaticResource Orbit.Text.Caption}" />
                        <Slider x:Name="ContrastSlider" Minimum="-1" Maximum="1" ValueChanged="OnAdjust" MouseDoubleClick="OnResetSlider" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource SliderRow}">
                        <TextBlock Text="Saturation" Style="{StaticResource Orbit.Text.Caption}" />
                        <Slider x:Name="SaturationSlider" Minimum="-1" Maximum="1" ValueChanged="OnAdjust" MouseDoubleClick="OnResetSlider" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource SliderRow}">
                        <TextBlock Text="Warmth" Style="{StaticResource Orbit.Text.Caption}" />
                        <Slider x:Name="WarmthSlider" Minimum="-1" Maximum="1" ValueChanged="OnAdjust" MouseDoubleClick="OnResetSlider" />
                    </StackPanel>
                    <Button Content="Reset" Style="{StaticResource Orbit.Button.Standard}" VerticalAlignment="Center" Click="OnResetAdjust" />
                </StackPanel>

                <StackPanel x:Name="MarkupPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Style="{StaticResource Orbit.SegmentHost}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ToolPen" Style="{StaticResource Orbit.Segment}" GroupName="Tool" Content="Pen" IsChecked="True" />
                            <RadioButton x:Name="ToolArrow" Style="{StaticResource Orbit.Segment}" GroupName="Tool" Content="Arrow" />
                            <RadioButton x:Name="ToolBox" Style="{StaticResource Orbit.Segment}" GroupName="Tool" Content="Box" />
                            <RadioButton x:Name="ToolText" Style="{StaticResource Orbit.Segment}" GroupName="Tool" Content="Text" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="Swatches" Orientation="Horizontal" Margin="20,0">
                        <RadioButton Style="{StaticResource Swatch}" Background="#FF3B30" ToolTip="Red" IsChecked="True" />
                        <RadioButton Style="{StaticResource Swatch}" Background="#FFCC00" ToolTip="Yellow" />
                        <RadioButton Style="{StaticResource Swatch}" Background="#34C759" ToolTip="Green" />
                        <RadioButton Style="{StaticResource Swatch}" Background="#0A84FF" ToolTip="Blue" />
                        <RadioButton Style="{StaticResource Swatch}" Background="#111114" ToolTip="Black" />
                        <RadioButton Style="{StaticResource Swatch}" Background="#FFFFFF" ToolTip="White" />
                    </StackPanel>
                    <Border Style="{StaticResource Orbit.SegmentHost}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SizeS" Style="{StaticResource Orbit.Segment}" GroupName="Size" Content="S" />
                            <RadioButton x:Name="SizeM" Style="{StaticResource Orbit.Segment}" GroupName="Size" Content="M" IsChecked="True" />
                            <RadioButton x:Name="SizeL" Style="{StaticResource Orbit.Segment}" GroupName="Size" Content="L" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RedactPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Style="{StaticResource Orbit.SegmentHost}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RedactBlack" Style="{StaticResource Orbit.Segment}" GroupName="Redact" Content="Black box" IsChecked="True" />
                            <RadioButton x:Name="RedactPixelate" Style="{StaticResource Orbit.Segment}" GroupName="Redact" Content="Pixelate" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Drag over anything you want hidden. It's burned into the copy and can't be undone there."
                               Style="{StaticResource ToolLabel}" Margin="16,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The photo -->
        <Grid x:Name="Stage" Margin="28" ClipToBounds="True">
            <Viewbox Stretch="Uniform" StretchDirection="Both">
                <Grid x:Name="Doc" Background="Transparent" Cursor="Cross"
                      MouseLeftButtonDown="OnDocDown" MouseMove="OnDocMove" MouseLeftButtonUp="OnDocUp">
                    <Image x:Name="Photo" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                    <ed:EditorLayer x:Name="Layer" IsHitTestVisible="False" />
                    <Canvas x:Name="TextHost" />
                </Grid>
            </Viewbox>
        </Grid>
    </DockPanel>
</Window>
