<!-- Flipr design tokens: LIGHT. Must match docs/design/design-system.md. Swapped live by ThemeManager. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:Boolean x:Key="Orbit.IsDark">False</sys:Boolean>

    <!-- Brand: Flip Teal #0EA5A4 is the fill in both modes (Brand.AccentHex); ink on it is #011F1E (5.7:1).
         AccentText is the readable shade for teal text on this mode's surfaces. -->
    <Color x:Key="Orbit.C.Accent">#0EA5A4</Color>
    <Color x:Key="Orbit.C.AccentHover">#14B8B6</Color>
    <Color x:Key="Orbit.C.AccentPressed">#0C9493</Color>
    <Color x:Key="Orbit.C.AccentText">#0A7C7B</Color>
    <Color x:Key="Orbit.C.AccentSubtle">#DFF5F4</Color>
    <Color x:Key="Orbit.C.OnAccent">#011F1E</Color>

    <!-- Neutrals -->
    <Color x:Key="Orbit.C.SurfaceBase">#F3F3F6</Color>
    <Color x:Key="Orbit.C.Surface">#FFFFFF</Color>
    <Color x:Key="Orbit.C.SurfaceAlt">#F7F7FA</Color>
    <Color x:Key="Orbit.C.Card">#B8FFFFFF</Color>
    <Color x:Key="Orbit.C.CardHover">#E6FFFFFF</Color>
    <Color x:Key="Orbit.C.Stroke">#E4E4EB</Color>
    <Color x:Key="Orbit.C.StrokeStrong">#CFCFDA</Color>
    <Color x:Key="Orbit.C.TextPrimary">#17171C</Color>
    <Color x:Key="Orbit.C.TextSecondary">#5D5D6B</Color>
    <Color x:Key="Orbit.C.TextTertiary">#8A8A97</Color>
    <Color x:Key="Orbit.C.SubtleFill">#0A000000</Color>
    <Color x:Key="Orbit.C.SubtleFillPressed">#14000000</Color>

    <!-- Semantic -->
    <Color x:Key="Orbit.C.Success">#1E8E5A</Color>
    <Color x:Key="Orbit.C.Warning">#B26B00</Color>
    <Color x:Key="Orbit.C.Danger">#C4314B</Color>

    <!-- Wheel material -->
    <Color x:Key="Orbit.C.WheelBase">#E6EFEF</Color>
    <Color x:Key="Orbit.C.WheelTint">#94FFFFFF</Color>
    <Color x:Key="Orbit.C.WheelSegment">#FFFFFF</Color>
    <sys:Double x:Key="Orbit.WheelSegmentOpacity">0.84</sys:Double>
    <Color x:Key="Orbit.C.WheelSegmentText">#17171C</Color>
    <Color x:Key="Orbit.C.WheelHub">#F0FFFFFF</Color>
    <Color x:Key="Orbit.C.WheelRimTop">#E60EA5A4</Color>
    <Color x:Key="Orbit.C.WheelRimBottom">#400EA5A4</Color>
    <sys:Double x:Key="Orbit.WheelShadowOpacity">0.20</sys:Double>
    <sys:Double x:Key="Orbit.ToastShadowOpacity">0.14</sys:Double>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Orbit.Accent" Color="{StaticResource Orbit.C.Accent}" />
    <SolidColorBrush x:Key="Orbit.AccentHover" Color="{StaticResource Orbit.C.AccentHover}" />
    <SolidColorBrush x:Key="Orbit.AccentPressed" Color="{StaticResource Orbit.C.AccentPressed}" />
    <SolidColorBrush x:Key="Orbit.AccentText" Color="{StaticResource Orbit.C.AccentText}" />
    <SolidColorBrush x:Key="Orbit.AccentSubtle" Color="{StaticResource Orbit.C.AccentSubtle}" />
    <SolidColorBrush x:Key="Orbit.OnAccent" Color="{StaticResource Orbit.C.OnAccent}" />
    <SolidColorBrush x:Key="Orbit.SurfaceBase" Color="{StaticResource Orbit.C.SurfaceBase}" />
    <SolidColorBrush x:Key="Orbit.Surface" Color="{StaticResource Orbit.C.Surface}" />
    <SolidColorBrush x:Key="Orbit.SurfaceAlt" Color="{StaticResource Orbit.C.SurfaceAlt}" />
    <SolidColorBrush x:Key="Orbit.CardFill" Color="{StaticResource Orbit.C.Card}" />
    <SolidColorBrush x:Key="Orbit.CardFillHover" Color="{StaticResource Orbit.C.CardHover}" />
    <SolidColorBrush x:Key="Orbit.Stroke" Color="{StaticResource Orbit.C.Stroke}" />
    <SolidColorBrush x:Key="Orbit.StrokeStrong" Color="{StaticResource Orbit.C.StrokeStrong}" />
    <SolidColorBrush x:Key="Orbit.TextPrimary" Color="{StaticResource Orbit.C.TextPrimary}" />
    <SolidColorBrush x:Key="Orbit.TextSecondary" Color="{StaticResource Orbit.C.TextSecondary}" />
    <SolidColorBrush x:Key="Orbit.TextTertiary" Color="{StaticResource Orbit.C.TextTertiary}" />
    <SolidColorBrush x:Key="Orbit.SubtleFill" Color="{StaticResource Orbit.C.SubtleFill}" />
    <SolidColorBrush x:Key="Orbit.SubtleFillPressed" Color="{StaticResource Orbit.C.SubtleFillPressed}" />
    <SolidColorBrush x:Key="Orbit.Success" Color="{StaticResource Orbit.C.Success}" />
    <SolidColorBrush x:Key="Orbit.Warning" Color="{StaticResource Orbit.C.Warning}" />
    <SolidColorBrush x:Key="Orbit.Danger" Color="{StaticResource Orbit.C.Danger}" />
</ResourceDictionary>
