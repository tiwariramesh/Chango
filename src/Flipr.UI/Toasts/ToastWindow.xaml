<Window x:Class="Flipr.UI.Toasts.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Width="372" SizeToContent="Height" Title="Flipr" UseLayoutRounding="True">
    <!-- 16 px margin leaves room for the E2 shadow on a per-pixel transparent window. -->
    <Grid x:Name="Root" Margin="16,12,16,20">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>

        <!-- Shadow lives on a sibling so the text above stays crisp (effects rasterise their content). -->
        <Border CornerRadius="8" Background="{DynamicResource Orbit.Surface}">
            <Border.Effect>
                <DropShadowEffect x:Name="Shadow" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.14" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="8" Background="{DynamicResource Orbit.Surface}" BorderBrush="{DynamicResource Orbit.Stroke}"
                BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3" />
                </Grid.RowDefinitions>

                <Grid Margin="14,12,8,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status: progress ring while running, glyph badge when finished. -->
                    <Grid Width="28" Height="28" VerticalAlignment="Top" Margin="0,1,0,0">
                        <Grid x:Name="RingHost">
                            <Ellipse Stroke="{DynamicResource Orbit.Stroke}" StrokeThickness="3" />
                            <Path x:Name="RingArc" Stroke="{DynamicResource Orbit.Accent}" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="RingSpin" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <Border x:Name="Badge" CornerRadius="14" Visibility="Collapsed">
                            <TextBlock x:Name="BadgeGlyph" Style="{StaticResource Orbit.Glyph}" FontSize="14"
                                       Foreground="{DynamicResource Orbit.OnAccent}" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Style="{StaticResource Orbit.Text.BodyStrong}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DetailText" Style="{StaticResource Orbit.Text.Caption}" Margin="0,2,0,0"
                                   MaxHeight="48" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="UndoButton" Content="Undo" Style="{StaticResource Orbit.Button.Link}"
                                Margin="0,2,2,0" Visibility="Collapsed" Click="OnUndo" ToolTip="Move what was just made to the Recycle Bin" />
                        <Button x:Name="ShowButton" Content="Show" Style="{StaticResource Orbit.Button.Link}"
                                Margin="0,2,2,0" Visibility="Collapsed" Click="OnShow" ToolTip="Show in File Explorer" />
                        <Button x:Name="CloseButton" Style="{StaticResource Orbit.Button.Subtle}" Width="28" Height="28"
                                MinHeight="0" Padding="0" Click="OnClose" ToolTip="Cancel">
                            <TextBlock Style="{StaticResource Orbit.Glyph}" Text="&#xE711;" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource Orbit.SubtleFill}" />
                <Border Grid.Row="1" x:Name="ProgressFill" Background="{DynamicResource Orbit.Accent}"
                        HorizontalAlignment="Left" Width="0" />
            </Grid>
        </Border>
    </Grid>
</Window>
