<Window x:Class="Flipr.UI.Trim.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:Flipr.UI.Trim"
        Title="Trim" Width="920" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Icon="pack://application:,,,/Flipr.UI;component/Assets/flipr.ico"
        Background="{DynamicResource Orbit.SurfaceBase}"
        FontFamily="{StaticResource Orbit.Font.Text}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Orbit.Surface}" BorderBrush="{DynamicResource Orbit.Stroke}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource Orbit.Button.Standard}" MinWidth="92" Margin="0,0,8,0" Click="OnCancel" />
                    <Button x:Name="SaveButton" Content="Save copy" Style="{StaticResource Orbit.Button.Accent}" MinWidth="108" Click="OnSave" />
                </StackPanel>
                <TextBlock x:Name="FileNameText" Style="{StaticResource Orbit.Text.BodyStrong}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Orbit.Surface}" BorderBrush="{DynamicResource Orbit.Stroke}" BorderThickness="0,1,0,0" Padding="20,14,20,16">
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button x:Name="PlayButton" DockPanel.Dock="Left" Style="{StaticResource Orbit.Button.Standard}" Width="44" Padding="0" Click="OnPlay" ToolTip="Play the selection (Space)">
                        <TextBlock x:Name="PlayGlyph" Style="{StaticResource Orbit.Glyph}" Text="&#xE768;" />
                    </Button>
                    <TextBlock x:Name="LengthText" DockPanel.Dock="Right" Style="{StaticResource Orbit.Text.BodyStrong}" VerticalAlignment="Center" />
                    <TextBlock x:Name="RangeText" Style="{StaticResource Orbit.Text.Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </DockPanel>
                <t:TrimBar x:Name="Bar" />
            </DockPanel>
        </Border>

        <Grid Margin="24">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform" />
            <StackPanel x:Name="AudioPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <Border Width="96" Height="96" CornerRadius="24" Background="{DynamicResource Orbit.SubtleFill}">
                    <TextBlock Style="{StaticResource Orbit.Glyph}" Text="&#xE8D6;" FontSize="40" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="Drag the handles to choose the part to keep" Style="{StaticResource Orbit.Text.Caption}" Margin="0,14,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
