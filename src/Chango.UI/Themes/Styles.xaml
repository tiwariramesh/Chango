<!--
  Chango control styles. Theme-independent: every colour is a DynamicResource token, so a theme switch
  restyles open windows instantly. Spacing follows the 4 px grid.
  Chango's shape language: pill buttons, toggles and selections (fully rounded), cards 12, menu rows 8.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Chango.Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Chango.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Chango.Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== Typography ===== -->
    <Style x:Key="Chango.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Chango.Font.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Chango.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Chango.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Chango.Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource Chango.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Chango.Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Chango.Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Chango.Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Chango.Font.Display}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Chango.TextPrimary}" />
    </Style>
    <Style x:Key="Chango.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Chango.Text.Subtitle}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="36" />
    </Style>
    <Style x:Key="Chango.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Chango.Font.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Chango.TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ===== Focus ===== -->
    <Style x:Key="Chango.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource Chango.Accent}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="Chango.Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Chango.Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="18,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Chango.FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="16" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chango.Button.Accent" TargetType="Button" BasedOn="{StaticResource Chango.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Chango.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Chango.OnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Chango.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Chango.AccentPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Chango.Button.Standard" TargetType="Button" BasedOn="{StaticResource Chango.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Chango.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Chango.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Chango.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Chango.SurfaceAlt}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Chango.StrokeStrong}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Chango.SubtleFillPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Chango.Button.Subtle" TargetType="Button" BasedOn="{StaticResource Chango.Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Chango.TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Chango.SubtleFill}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Chango.SubtleFillPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Chango.Button.Link" TargetType="Button" BasedOn="{StaticResource Chango.Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Chango.AccentText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Chango.SubtleFill}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Menu row (tray flyout): icon + label, full width. Content is set by the caller. -->
    <Style x:Key="Chango.Button.MenuRow" TargetType="Button" BasedOn="{StaticResource Chango.Button.Subtle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="6,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Toggle switch (CheckBox) ===== -->
    <Style x:Key="Chango.ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Chango.FocusVisual}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock x:Name="State" Text="Off" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Style="{StaticResource Chango.Text.Body}" Foreground="{DynamicResource Chango.TextSecondary}" />
                        <Grid Width="44" Height="24">
                            <Border x:Name="Track" CornerRadius="12" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource Chango.StrokeStrong}" Background="{DynamicResource Chango.SubtleFill}" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" HorizontalAlignment="Left" Margin="4,0,0,0"
                                     Fill="{DynamicResource Chango.TextTertiary}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Chango.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Chango.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="White" />
                            <Setter TargetName="State" Property="Text" Value="On" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Chango.SubtleFillPressed}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Chango.AccentHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Segmented choice (RadioButton) ===== -->
    <Style x:Key="Chango.Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Chango.FocusVisual}" />
        <Setter Property="FontFamily" Value="{StaticResource Chango.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Chango.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chip" CornerRadius="14" Padding="14,5" Margin="2" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Chango.SubtleFill}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Chango.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Chango.OnAccent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chango.SegmentHost" TargetType="Border">
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="Background" Value="{DynamicResource Chango.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Chango.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Theme picker card (RadioButton with preview) ===== -->
    <Style x:Key="Chango.ThemeCard" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Chango.FocusVisual}" />
        <Setter Property="Width" Value="132" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel>
                        <Border x:Name="Frame" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Chango.Stroke}" Padding="3">
                            <ContentPresenter />
                        </Border>
                        <TextBlock Text="{TemplateBinding Tag}" Margin="0,8,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource Chango.Text.Body}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Chango.StrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Chango.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Cards & navigation ===== -->
    <Style x:Key="Chango.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Chango.CardFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Chango.GlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="MinHeight" Value="64" />
    </Style>

    <Style x:Key="Chango.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Chango.Text.BodyStrong}">
        <Setter Property="Margin" Value="2,20,0,8" />
    </Style>

    <!-- Navigation: the selected page is a frosted pill with teal text and a teal dot; labels and icons inherit its ink. -->
    <Style x:Key="Chango.NavItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Chango.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Chango.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="0,2">
                        <Border x:Name="Bg" CornerRadius="19" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Height="38" />
                        <ContentPresenter x:Name="Content" Margin="16,0" VerticalAlignment="Center" />
                        <Ellipse x:Name="Dot" Width="6" Height="6" HorizontalAlignment="Right" Margin="0,0,16,0"
                                 Fill="{DynamicResource Chango.Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Chango.SubtleFill}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Chango.GlassStrong}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Chango.GlassStroke}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Content" Property="TextElement.FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource Chango.AccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chango.NavLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Chango.Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Chango.NavGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Chango.Font.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,14,0" />
    </Style>

    <!-- A frosted glass panel (navigation rail, tour panel). -->
    <Style x:Key="Chango.GlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Chango.Glass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Chango.GlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>

    <!-- Page title with Chango's underline. -->
    <Style x:Key="Chango.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Chango.Text.Title}">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Margin" Value="2,0,0,0" />
    </Style>
    <Style x:Key="Chango.TitleBar" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource Chango.BrandBar}" />
        <Setter Property="Margin" Value="3,6,0,18" />
    </Style>

    <!-- A setting's icon sits in a round, neutral badge; the icon itself is teal. -->
    <Style x:Key="Chango.IconBadge" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="{DynamicResource Chango.Badge}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
