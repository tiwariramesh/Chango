<!-- Chango design tokens: LIGHT. Must match docs/design/design-system.md. Swapped live by ThemeManager. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:Boolean x:Key="Chango.IsDark">False</sys:Boolean>

    <!-- Brand: Chango Teal #0EA5A4 is the fill in both modes (Brand.AccentHex); ink on it is #011F1E (5.7:1).
         AccentText is the readable shade for teal text on this mode's surfaces. -->
    <Color x:Key="Chango.C.Accent">#0EA5A4</Color>
    <Color x:Key="Chango.C.AccentHover">#14B8B6</Color>
    <Color x:Key="Chango.C.AccentPressed">#0C9493</Color>
    <Color x:Key="Chango.C.AccentText">#0A7C7B</Color>
    <Color x:Key="Chango.C.AccentSubtle">#DFF5F4</Color>
    <Color x:Key="Chango.C.OnAccent">#011F1E</Color>

    <!-- Neutrals -->
    <Color x:Key="Chango.C.SurfaceBase">#EDF1F4</Color>
    <Color x:Key="Chango.C.Surface">#FFFFFF</Color>
    <Color x:Key="Chango.C.SurfaceAlt">#F7F7FA</Color>
    <Color x:Key="Chango.C.Card">#A8FFFFFF</Color>
    <Color x:Key="Chango.C.CardHover">#D9FFFFFF</Color>
    <Color x:Key="Chango.C.Stroke">#E4E4EB</Color>
    <Color x:Key="Chango.C.StrokeStrong">#CFCFDA</Color>
    <Color x:Key="Chango.C.TextPrimary">#17171C</Color>
    <Color x:Key="Chango.C.TextSecondary">#5D5D6B</Color>
    <Color x:Key="Chango.C.TextTertiary">#8A8A97</Color>
    <Color x:Key="Chango.C.SubtleFill">#0A000000</Color>
    <Color x:Key="Chango.C.SubtleFillPressed">#14000000</Color>

    <!-- Semantic -->
    <Color x:Key="Chango.C.Success">#1E8E5A</Color>
    <Color x:Key="Chango.C.Warning">#B26B00</Color>
    <Color x:Key="Chango.C.Danger">#C4314B</Color>

    <!-- Wheel material -->
    <Color x:Key="Chango.C.WheelBase">#E6EFEF</Color>
    <Color x:Key="Chango.C.WheelTint">#94FFFFFF</Color>
    <Color x:Key="Chango.C.WheelSegment">#FFFFFF</Color>
    <sys:Double x:Key="Chango.WheelSegmentOpacity">0.84</sys:Double>
    <Color x:Key="Chango.C.WheelSegmentText">#17171C</Color>
    <Color x:Key="Chango.C.WheelHub">#F0FFFFFF</Color>
    <Color x:Key="Chango.C.WheelRimTop">#E60EA5A4</Color>
    <Color x:Key="Chango.C.WheelRimBottom">#400EA5A4</Color>
    <sys:Double x:Key="Chango.WheelShadowOpacity">0.20</sys:Double>
    <sys:Double x:Key="Chango.ToastShadowOpacity">0.14</sys:Double>

    <!-- Logo palette: deep blue, teal (the accent's family) and mint. -->
    <Color x:Key="Chango.C.Deep">#115469</Color>
    <Color x:Key="Chango.C.Mint">#94EAE3</Color>

    <!-- Glass: frosted panels with a bright top edge, over a soft wash of the logo's colours (Chango.Ambient). -->
    <Color x:Key="Chango.C.Glass">#A6FFFFFF</Color>
    <Color x:Key="Chango.C.GlassStrong">#E6FFFFFF</Color>
    <Color x:Key="Chango.C.GlassEdge">#F2FFFFFF</Color>
    <Color x:Key="Chango.C.GlassEdgeLow">#2915303A</Color>
    <Color x:Key="Chango.C.StageTint">#E4ECF2</Color>
    <Color x:Key="Chango.C.Badge">#E9F0F3</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Chango.Accent" Color="{StaticResource Chango.C.Accent}" />
    <SolidColorBrush x:Key="Chango.AccentHover" Color="{StaticResource Chango.C.AccentHover}" />
    <SolidColorBrush x:Key="Chango.AccentPressed" Color="{StaticResource Chango.C.AccentPressed}" />
    <SolidColorBrush x:Key="Chango.AccentText" Color="{StaticResource Chango.C.AccentText}" />
    <SolidColorBrush x:Key="Chango.AccentSubtle" Color="{StaticResource Chango.C.AccentSubtle}" />
    <SolidColorBrush x:Key="Chango.OnAccent" Color="{StaticResource Chango.C.OnAccent}" />
    <SolidColorBrush x:Key="Chango.SurfaceBase" Color="{StaticResource Chango.C.SurfaceBase}" />
    <SolidColorBrush x:Key="Chango.Surface" Color="{StaticResource Chango.C.Surface}" />
    <SolidColorBrush x:Key="Chango.SurfaceAlt" Color="{StaticResource Chango.C.SurfaceAlt}" />
    <SolidColorBrush x:Key="Chango.CardFill" Color="{StaticResource Chango.C.Card}" />
    <SolidColorBrush x:Key="Chango.CardFillHover" Color="{StaticResource Chango.C.CardHover}" />
    <SolidColorBrush x:Key="Chango.Stroke" Color="{StaticResource Chango.C.Stroke}" />
    <SolidColorBrush x:Key="Chango.StrokeStrong" Color="{StaticResource Chango.C.StrokeStrong}" />
    <SolidColorBrush x:Key="Chango.TextPrimary" Color="{StaticResource Chango.C.TextPrimary}" />
    <SolidColorBrush x:Key="Chango.TextSecondary" Color="{StaticResource Chango.C.TextSecondary}" />
    <SolidColorBrush x:Key="Chango.TextTertiary" Color="{StaticResource Chango.C.TextTertiary}" />
    <SolidColorBrush x:Key="Chango.SubtleFill" Color="{StaticResource Chango.C.SubtleFill}" />
    <SolidColorBrush x:Key="Chango.SubtleFillPressed" Color="{StaticResource Chango.C.SubtleFillPressed}" />
    <SolidColorBrush x:Key="Chango.Success" Color="{StaticResource Chango.C.Success}" />
    <SolidColorBrush x:Key="Chango.Warning" Color="{StaticResource Chango.C.Warning}" />
    <SolidColorBrush x:Key="Chango.Danger" Color="{StaticResource Chango.C.Danger}" />
    <SolidColorBrush x:Key="Chango.Deep" Color="{StaticResource Chango.C.Deep}" />
    <SolidColorBrush x:Key="Chango.Mint" Color="{StaticResource Chango.C.Mint}" />
    <SolidColorBrush x:Key="Chango.Glass" Color="{StaticResource Chango.C.Glass}" />
    <SolidColorBrush x:Key="Chango.GlassStrong" Color="{StaticResource Chango.C.GlassStrong}" />
    <SolidColorBrush x:Key="Chango.StageTint" Color="{StaticResource Chango.C.StageTint}" />
    <SolidColorBrush x:Key="Chango.Badge" Color="{StaticResource Chango.C.Badge}" />
    <LinearGradientBrush x:Key="Chango.GlassStroke" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Chango.C.GlassEdge}" Offset="0" />
        <GradientStop Color="{StaticResource Chango.C.GlassEdgeLow}" Offset="1" />
    </LinearGradientBrush>
    <!-- Page titles: a short bar running from the logo's deep blue into teal. -->
    <LinearGradientBrush x:Key="Chango.BrandBar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Chango.C.Deep}" Offset="0" />
        <GradientStop Color="{StaticResource Chango.C.Accent}" Offset="1" />
    </LinearGradientBrush>
    <!-- The window background behind glass: the base colour with soft, blurred washes of the logo palette. -->
    <DrawingBrush x:Key="Chango.Ambient" Stretch="Fill" ViewboxUnits="Absolute" Viewbox="0,0,100,100">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Chango.SurfaceBase}">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush><GradientStop Color="#4020B4A6" Offset="0" /><GradientStop Color="#0020B4A6" Offset="1" /></RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><EllipseGeometry Center="8,10" RadiusX="50" RadiusY="44" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush><GradientStop Color="#3A115469" Offset="0" /><GradientStop Color="#00115469" Offset="1" /></RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><EllipseGeometry Center="96,90" RadiusX="58" RadiusY="52" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush><GradientStop Color="#5C94EAE3" Offset="0" /><GradientStop Color="#0094EAE3" Offset="1" /></RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><EllipseGeometry Center="88,6" RadiusX="42" RadiusY="36" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush><GradientStop Color="#1F115469" Offset="0" /><GradientStop Color="#00115469" Offset="1" /></RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><EllipseGeometry Center="10,96" RadiusX="36" RadiusY="30" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
