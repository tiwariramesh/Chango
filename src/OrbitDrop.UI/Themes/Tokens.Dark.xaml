<!-- OrbitDrop design tokens: DARK. Must match docs/design/design-system.md. Swapped live by ThemeManager. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:Boolean x:Key="Orbit.IsDark">True</sys:Boolean>

    <!-- Brand -->
    <Color x:Key="Orbit.C.Accent">#F4F4F6</Color>
    <Color x:Key="Orbit.C.AccentHover">#FFFFFF</Color>
    <Color x:Key="Orbit.C.AccentPressed">#D9D9DE</Color>
    <Color x:Key="Orbit.C.AccentText">#FFFFFF</Color>
    <Color x:Key="Orbit.C.AccentSubtle">#2E2E34</Color>
    <Color x:Key="Orbit.C.OnAccent">#111114</Color>

    <!-- Neutrals -->
    <Color x:Key="Orbit.C.SurfaceBase">#1C1C21</Color>
    <Color x:Key="Orbit.C.Surface">#26262D</Color>
    <Color x:Key="Orbit.C.SurfaceAlt">#2D2D35</Color>
    <Color x:Key="Orbit.C.Card">#B32B2B33</Color>
    <Color x:Key="Orbit.C.CardHover">#E6303039</Color>
    <Color x:Key="Orbit.C.Stroke">#3A3A45</Color>
    <Color x:Key="Orbit.C.StrokeStrong">#4C4C58</Color>
    <Color x:Key="Orbit.C.TextPrimary">#F3F3F7</Color>
    <Color x:Key="Orbit.C.TextSecondary">#B7B7C3</Color>
    <Color x:Key="Orbit.C.TextTertiary">#868694</Color>
    <Color x:Key="Orbit.C.SubtleFill">#0FFFFFFF</Color>
    <Color x:Key="Orbit.C.SubtleFillPressed">#08FFFFFF</Color>

    <!-- Semantic -->
    <Color x:Key="Orbit.C.Success">#4CC38A</Color>
    <Color x:Key="Orbit.C.Warning">#F5B04C</Color>
    <Color x:Key="Orbit.C.Danger">#FF7A8A</Color>

    <!-- Wheel material -->
    <Color x:Key="Orbit.C.WheelBase">#232329</Color>
    <Color x:Key="Orbit.C.WheelTint">#9E1D1D23</Color>
    <Color x:Key="Orbit.C.WheelSegment">#2F2F38</Color>
    <sys:Double x:Key="Orbit.WheelSegmentOpacity">0.86</sys:Double>
    <Color x:Key="Orbit.C.WheelSegmentText">#F3F3F7</Color>
    <Color x:Key="Orbit.C.WheelHub">#F52A2A32</Color>
    <Color x:Key="Orbit.C.WheelRimTop">#38FFFFFF</Color>
    <Color x:Key="Orbit.C.WheelRimBottom">#0FFFFFFF</Color>
    <sys:Double x:Key="Orbit.WheelShadowOpacity">0.50</sys:Double>
    <sys:Double x:Key="Orbit.ToastShadowOpacity">0.40</sys:Double>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Orbit.Accent" Color="{StaticResource Orbit.C.Accent}" />
    <SolidColorBrush x:Key="Orbit.AccentHover" Color="{StaticResource Orbit.C.AccentHover}" />
    <SolidColorBrush x:Key="Orbit.AccentPressed" Color="{StaticResource Orbit.C.AccentPressed}" />
    <SolidColorBrush x:Key="Orbit.AccentText" Color="{StaticResource Orbit.C.AccentText}" />
    <SolidColorBrush x:Key="Orbit.AccentSubtle" Color="{StaticResource Orbit.C.AccentSubtle}" />
    <SolidColorBrush x:Key="Orbit.OnAccent" Color="{StaticResource Orbit.C.OnAccent}" />
    <SolidColorBrush x:Key="Orbit.SurfaceBase" Color="{StaticResource Orbit.C.SurfaceBase}" />
    <SolidColorBrush x:Key="Orbit.Surface" Color="{StaticResource Orbit.C.Surface}" />
    <SolidColorBrush x:Key="Orbit.SurfaceAlt" Color="{StaticResource Orbit.C.SurfaceAlt}" />
    <SolidColorBrush x:Key="Orbit.CardFill" Color="{StaticResource Orbit.C.Card}" />
    <SolidColorBrush x:Key="Orbit.CardFillHover" Color="{StaticResource Orbit.C.CardHover}" />
    <SolidColorBrush x:Key="Orbit.Stroke" Color="{StaticResource Orbit.C.Stroke}" />
    <SolidColorBrush x:Key="Orbit.StrokeStrong" Color="{StaticResource Orbit.C.StrokeStrong}" />
    <SolidColorBrush x:Key="Orbit.TextPrimary" Color="{StaticResource Orbit.C.TextPrimary}" />
    <SolidColorBrush x:Key="Orbit.TextSecondary" Color="{StaticResource Orbit.C.TextSecondary}" />
    <SolidColorBrush x:Key="Orbit.TextTertiary" Color="{StaticResource Orbit.C.TextTertiary}" />
    <SolidColorBrush x:Key="Orbit.SubtleFill" Color="{StaticResource Orbit.C.SubtleFill}" />
    <SolidColorBrush x:Key="Orbit.SubtleFillPressed" Color="{StaticResource Orbit.C.SubtleFillPressed}" />
    <SolidColorBrush x:Key="Orbit.Success" Color="{StaticResource Orbit.C.Success}" />
    <SolidColorBrush x:Key="Orbit.Warning" Color="{StaticResource Orbit.C.Warning}" />
    <SolidColorBrush x:Key="Orbit.Danger" Color="{StaticResource Orbit.C.Danger}" />
</ResourceDictionary>
