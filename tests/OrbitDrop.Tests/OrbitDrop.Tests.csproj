    <ProjectReference Include="../../src/OrbitDrop.Jobs/OrbitDrop.Jobs.csproj" />
    <ProjectReference Include="../../src/OrbitDrop.Conversion/OrbitDrop.Conversion.csproj" />
    <ProjectReference Include="../../src/OrbitDrop.Tools/OrbitDrop.Tools.csproj" />
    <ProjectReference Include="../../src/OrbitDrop.Windows/OrbitDrop.Windows.csproj" />
    <ProjectReference Include="../../src/OrbitDrop.UI/OrbitDrop.UI.csproj" />
  </ItemGroup>
</Project>
