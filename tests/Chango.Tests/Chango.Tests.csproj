    <ProjectReference Include="../../src/Chango.Jobs/Chango.Jobs.csproj" />
    <ProjectReference Include="../../src/Chango.Conversion/Chango.Conversion.csproj" />
    <ProjectReference Include="../../src/Chango.Tools/Chango.Tools.csproj" />
