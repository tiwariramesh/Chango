<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store (MSIX) manifest. Identity values come from Partner Center → Product identity and must match it
  exactly: replace {IDENTITY_NAME} and {PUBLISHER_ID} with the values Partner Center shows (package-store.ps1
  refuses to build until they are). {VERSION} is filled in by build/store/package-store.ps1 (Store versions end in .0).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  IgnorableNamespaces="uap desktop rescap com desktop4 desktop5">

  <Identity
    Name="{IDENTITY_NAME}"
    Publisher="{PUBLISHER_ID}"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Chango</DisplayName>
    <PublisherDisplayName>Ramesh Tiwari</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Drag a file, tap Shift and change it into PDF, Word, Excel, JPG, MP3 and more, right where it is.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Chango" Executable="Chango.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Chango"
        Description="Change files into the format you need, right where they are."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Chango" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start Chango when I sign in" (Settings → General); off until the user turns it on. -->
        <desktop:Extension Category="windows.startupTask" Executable="Chango.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="ChangoStartup" Enabled="false" DisplayName="Chango" />
        </desktop:Extension>
        <!-- "Chango" in File Explorer's right-click menu (Windows 11's main menu), for files and folders. The entry
             is ChangoShell.dll (src/Chango.ShellMenu): it only hands the chosen paths to Chango. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="Chango" Clsid="29BADCB7-5BF2-4D63-84F8-67D64C5194F5" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="Chango" Clsid="29BADCB7-5BF2-4D63-84F8-67D64C5194F5" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Chango right-click menu">
              <com:Class Id="29BADCB7-5BF2-4D63-84F8-67D64C5194F5" Path="ChangoShell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A classic desktop app: it watches for file drags system-wide and shows its wheel over other windows. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
