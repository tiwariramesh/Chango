<Project>
  <!-- Shared settings for src/ and tests/ (the Orbit Probe experiment stays independent). -->
  <PropertyGroup>
    <OrbitWindowsTfm>net10.0-windows10.0.19041.0</OrbitWindowsTfm>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0-beta</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Flipr</Product>
    <Company>Ramesh Tiwari</Company>
    <Authors>Ramesh Tiwari</Authors>
    <Copyright>© 2026 Ramesh Tiwari · based on OrbitDrop © 2026 Mohammed Essam · MIT License</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- WPF Fluent ThemeMode is marked experimental in .NET 10; usage is isolated in ThemeManager. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
</Project>
