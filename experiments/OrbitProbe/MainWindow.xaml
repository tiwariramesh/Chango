<Window x:Class="OrbitProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit Probe — Chango feasibility experiment"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Orbit Probe" />
                <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,10"
                           Text="Drag files in Explorer or on the desktop, tap Shift while dragging, release over a segment. Tap Shift again to switch mode. Esc cancels." />

                <GroupBox Header="Drop target (H-1, H-5, H-6, H-7)" Padding="6">
                    <StackPanel>
                        <RadioButton x:Name="VariantNative" Content="B — native COM IDropTarget (recommended)" IsChecked="True" Checked="OnSettingChanged" />
                        <RadioButton x:Name="VariantWpf" Content="A — WPF AllowDrop" Checked="OnSettingChanged" />
                        <CheckBox x:Name="UseHelper" Content="IDropTargetHelper (keeps drag image correct) — B only" IsChecked="True" Margin="18,6,0,0" Click="OnSettingChanged" />
                        <CheckBox x:Name="UseDescriptions" Content="Drop descriptions ('Convert to PNG') — B only" IsChecked="True" Margin="18,2,0,0" Click="OnSettingChanged" />
                        <CheckBox x:Name="BelowDragImage" Content="Place wheel below the drag image in z-order" Margin="0,6,0,0" Click="OnSettingChanged" />
                        <CheckBox x:Name="Animate" Content="Bloom animation" IsChecked="True" Click="OnSettingChanged" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Drag-start signals used to arm Shift (H-3)" Padding="6" Margin="0,8,0,0">
                    <StackPanel>
                        <CheckBox x:Name="ArmOle" Content="(a) EVENT_SYSTEM_DRAGDROPSTART WinEvent" IsChecked="True" Click="OnSettingChanged" />
                        <CheckBox x:Name="ArmImage" Content="(b) Shell 'SysDragImage' window shown" IsChecked="True" Click="OnSettingChanged" />
                        <CheckBox x:Name="ArmHook" Content="(c) Low-level mouse hook heuristic" IsChecked="True" Click="OnSettingChanged" />
                        <CheckBox x:Name="ArmButton" Content="Diagnostic: open on Shift whenever button is held (isolates H-1)" Margin="0,6,0,0" Click="OnSettingChanged" />
                    </StackPanel>
                </GroupBox>

                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Create test files" Padding="10,4" Margin="0,0,6,6" Click="OnCreateFixtures" />
                    <Button Content="Open C:\OrbitTest" Padding="10,4" Margin="0,0,6,6" Click="OnOpenFixtures" />
                    <Button Content="Preview wheel (4 s)" Padding="10,4" Margin="0,0,6,6" Click="OnPreview" />
                    <Button Content="Reset statistics" Padding="10,4" Margin="0,0,6,6" Click="OnResetStats" />
                    <Button Content="Copy summary" Padding="10,4" Margin="0,0,6,6" Click="OnCopySummary" />
                    <Button Content="Open log file" Padding="10,4" Margin="0,0,6,6" Click="OnOpenLog" />
                </WrapPanel>

                <GroupBox Header="Statistics" Padding="6" Margin="0,6,0,0">
                    <TextBlock x:Name="StatsText" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" TextWrapping="NoWrap" />
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" x:Name="LogPathText" Opacity="0.7" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
            <ListBox x:Name="LogList" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
        </DockPanel>
    </Grid>
</Window>
