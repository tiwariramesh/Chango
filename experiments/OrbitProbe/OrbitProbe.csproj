<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Orbit Probe: throwaway feasibility experiment for Chango (Master Brief, Step 3).
    NOT part of the product solution. No third-party dependencies by design.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>OrbitProbe</RootNamespace>
    <AssemblyName>OrbitProbe</AssemblyName>
    <Version>0.0.1</Version>
  </PropertyGroup>

</Project>
