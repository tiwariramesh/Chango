<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generates Chango's icon set from the logo SVGs. Usage: dotnet run (project) tools/IconGen [logoFolder] [outputFolder] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="Svg.Skia" Version="4.9.1" />
  </ItemGroup>
</Project>
